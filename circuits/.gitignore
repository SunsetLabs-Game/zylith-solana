# Build artifacts — ignore intermediate files but KEEP final artifacts
# (mint.wasm, circuit_final.zkey, mint_js/, verification_key.json) needed by the ASP server
build/**/*.r1cs
build/**/*.sym
build/**/*.json
!build/**/verification_key.json
build/**/pot*.ptau

# Verification / proving keys checked in at root of build subdirs
# (do NOT ignore *.zkey and *.wasm — they are required by Railway)

# Verification keys (only at root circuits/, not inside build/)
proving_key.json

# Node modules
node_modules/
package-lock.json

# Witness files
witness.wtns
witness.json

# Testing
test_vectors/
*.test.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
